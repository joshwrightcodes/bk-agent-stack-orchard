<mxCell id="e45" value="Exports metrics,&#10;traces, and logs.&#10;[OTLP]" style="edgeStyle=none;rounded=1;arcSize=12;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2328;strokeColor=#7d8590;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#f6f8fa;labelBorderColor=#d0d7de;labelPadding=4;jumpStyle=arc;jumpSize=10;exitX=0.55;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ctl" target="tel"><mxGeometry x="0.5832" relative="1" as="geometry"><Array as="points"><mxPoint x="405.5" y="-55"/><mxPoint x="1310" y="-55"/><mxPoint x="1310" y="1306.9"/></Array></mxGeometry></mxCell>
<mxCell id="e46" value="Reads and&#10;writes state." style="edgeStyle=none;rounded=1;arcSize=12;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2328;strokeColor=#7d8590;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#f6f8fa;labelBorderColor=#d0d7de;labelPadding=4;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.45;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.44653846153846155;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="oc" target="st"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e47" value="Exports metrics.&#10;[OTLP]" style="edgeStyle=none;rounded=1;arcSize=12;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2328;strokeColor=#7d8590;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#f6f8fa;labelBorderColor=#d0d7de;labelPadding=4;jumpStyle=arc;jumpSize=10;exitX=0.9;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="oc" target="tel"><mxGeometry x="-0.1383" relative="1" as="geometry"><Array as="points"><mxPoint x="869" y="554"/><mxPoint x="1190" y="554"/></Array></mxGeometry></mxCell>
<mxCell id="e48" value="Registers. Gets VM&#10;assignments. Reports&#10;VM status.&#10;[gRPC, outbound from&#10;the Mac host]" style="edgeStyle=none;rounded=1;arcSize=12;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2328;strokeColor=#7d8590;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#f6f8fa;labelBorderColor=#d0d7de;labelPadding=4;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="w" target="oc"><mxGeometry x="-0.1111" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e49" value="Pulls, clones,&#10;configures, runs, stops,&#10;and deletes VMs.&#10;[CLI]" style="edgeStyle=none;rounded=1;arcSize=12;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2328;strokeColor=#7d8590;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#f6f8fa;labelBorderColor=#d0d7de;labelPadding=4;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="w" target="t"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell>
