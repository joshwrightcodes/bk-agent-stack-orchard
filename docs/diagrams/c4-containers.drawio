<mxCell id="e53" value="Runs.&#10;[Virtualization.framework]" style="edgeStyle=none;rounded=1;arcSize=12;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2328;strokeColor=#7d8590;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#f6f8fa;labelBorderColor=#d0d7de;labelPadding=4;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.4;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.4930232558139535;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="t" target="vm"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e54" value="Acquires its job.&#10;Sends logs,&#10;artifacts, and the&#10;result.&#10;[Agent API, HTTPS]" style="edgeStyle=none;rounded=1;arcSize=12;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2328;strokeColor=#7d8590;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#f6f8fa;labelBorderColor=#d0d7de;labelPadding=4;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="vm" target="bk"><mxGeometry x="0.4538" relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="976.7"/></Array></mxGeometry></mxCell>
