{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values of bk-agent-stack-orchard",
  "description": "A first check of the values, before the chart renders. It mirrors the rules of the controller that JSON Schema can express: names, tags, whole-second lifetimes, softnetAllow ranges, and VM_ variables. It cannot express every rule, for example host bits in a CIDR range, two profiles with the same match map, a timeout sum that is longer than jobTokenLifetime, and a list that repeats an entry in another spelling. The controller checks all of its rules when it starts, and it is the authority: a value that passes this schema can still stop the controller. See the README of the chart.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "config", "secret"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "config": {
      "description": "The configuration file of the controller (target design, section 8). The controller checks the rest when it starts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["controllerID", "healthAddress", "buildkite", "orchard"],
      "properties": {
        "controllerID": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,21}[a-z0-9])?$"},
        "healthAddress": {"type": "string", "pattern": ":[0-9]+$"},
        "maxInFlight": {"type": "integer", "minimum": 0},
        "stateFreshness": {"$ref": "#/definitions/duration"},
        "buildkite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queue"],
          "properties": {
            "queue": {"$ref": "#/definitions/queue"},
            "endpoint": {"type": "string", "pattern": "^[hH][tT][tT][pP]([sS])?://.+"},
            "plainHTTPEndpoint": {"type": "boolean"},
            "pollInterval": {"$ref": "#/definitions/duration"},
            "jobStatesInterval": {"$ref": "#/definitions/duration"},
            "reservationExpiry": {
              "description": "A Go duration. The controller checks that it is a whole number of seconds from 1 to 3600 when it starts.",
              "$ref": "#/definitions/duration"
            },
            "reservationRenewBefore": {"$ref": "#/definitions/duration"},
            "jobTokenLifetime": {
              "description": "A Go duration. The controller checks that it is a whole number of seconds from 1 to 1800 when it starts.",
              "$ref": "#/definitions/duration"
            }
          }
        },
        "orchard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": {"type": "string", "pattern": "^[hH][tT][tT][pP]([sS])?://.+"},
            "serviceAccount": {"type": "string", "minLength": 1},
            "inventoryInterval": {"$ref": "#/definitions/duration"},
            "workerOfflineTimeout": {"$ref": "#/definitions/duration"}
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeouts": {"$ref": "#/definitions/timeouts"},
            "agent": {"$ref": "#/definitions/agent"}
          }
        },
        "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/profile"}}
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string"},
        "protocol": {"enum": ["grpc", "http/protobuf"]}
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "valueFrom": {"type": "object"}
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "priorityClassName": {"type": "string"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"$ref": "#/definitions/quantities"},
        "limits": {"$ref": "#/definitions/quantities"},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"type": "string"}, "request": {"type": "string"}}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "buildkite": {"$ref": "#/definitions/destination"},
        "orchard": {"$ref": "#/definitions/destination"},
        "collector": {"$ref": "#/definitions/destination"}
      }
    },
    "deploymentAnnotations": {"$ref": "#/definitions/stringMap"},
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "podLabels": {"$ref": "#/definitions/stringMap"},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "operator": {"enum": ["Exists", "Equal"]},
          "value": {"type": "string"},
          "effect": {"enum": ["", "NoSchedule", "PreferNoSchedule", "NoExecute"]},
          "tolerationSeconds": {"type": "integer"}
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": {"type": "object"},
        "podAffinity": {"type": "object"},
        "podAntiAffinity": {"type": "object"}
      }
    }
  },
  "definitions": {
    "duration": {
      "description": "A Go duration, such as 5s, 2m, or 25h, as time.ParseDuration reads it. A bare number is not a duration. The controller checks the ranges.",
      "type": "string",
      "pattern": "^[-+]?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+$"
    },
    "timeoutDuration": {
      "description": "A Go duration, or the text 0, which means that the profile takes the default.",
      "anyOf": [{"$ref": "#/definitions/duration"}, {"const": "0"}]
    },
    "queue": {
      "description": "No comma, quote, newline or carriage return, and no ASCII white space at an end, because the agent reads its tags as one comma-separated list.",
      "type": "string",
      "pattern": "^[^,\\n\\r\"'\\s]$|^[^,\\n\\r\"'\\s][^,\\n\\r\"']*[^,\\n\\r\"'\\s]$"
    },
    "tagValue": {
      "description": "A literal tag value: no wildcard (* ? !), no comma, quote, newline or carriage return, and no ASCII white space at an end.",
      "type": "string",
      "pattern": "^[^*?!,\\n\\r\"'\\s]$|^[^*?!,\\n\\r\"'\\s][^*?!,\\n\\r\"']*[^*?!,\\n\\r\"'\\s]$"
    },
    "vmVariable": {
      "description": "The name of a variable that goes into the VMs. It MUST start with VM_.",
      "type": "string",
      "pattern": "^VM_"
    },
    "ipv4Range": {
      "description": "An IPv4 CIDR range with a prefix length from 16 to 32. The controller also refuses host bits and a repeated range.",
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(1[6-9]|2[0-9]|3[0-2])$"
    },
    "agent": {
      "description": "Where the agent of a VM comes from: download (the default) or image. url and sha256 name one release archive, and are set together. The controller default is the release that it was tested with.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"enum": ["download", "image"]},
        "url": {"type": "string", "pattern": "^https://[^/]+/.*"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unplaced": {"$ref": "#/definitions/timeoutDuration"},
        "boot": {"$ref": "#/definitions/timeoutDuration"},
        "acquire": {"$ref": "#/definitions/timeoutDuration"},
        "maxVMLifetime": {"$ref": "#/definitions/timeoutDuration"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "match", "image", "cpu", "memoryMiB", "diskSizeGB"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "match": {
          "description": "Literal tags. The keys queue, profile and agent-stack are reserved.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "not": {"enum": ["queue", "profile", "agent-stack"]}
          },
          "additionalProperties": {"$ref": "#/definitions/tagValue"}
        },
        "image": {"type": "string", "minLength": 1},
        "cpu": {"type": "integer", "minimum": 1},
        "memoryMiB": {"type": "integer", "minimum": 1},
        "diskSizeGB": {"type": "integer", "minimum": 1},
        "workerLabels": {"$ref": "#/definitions/stringMap"},
        "softnetAllow": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/ipv4Range"}
        },
        "startupTransport": {"enum": ["tart-guest-agent", "ssh"]},
        "vmCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usernameEnv", "passwordEnv"],
          "properties": {
            "usernameEnv": {"$ref": "#/definitions/vmVariable"},
            "passwordEnv": {"$ref": "#/definitions/vmVariable"}
          }
        },
        "timeouts": {"$ref": "#/definitions/timeouts"},
        "agent": {"$ref": "#/definitions/agent"},
        "otel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "endpoint": {"type": "string"},
            "headersEnv": {"description": "Empty or the name of a variable that starts with VM_.", "type": "string", "pattern": "^(VM_.*)?$"}
          }
        }
      }
    },
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "quantities": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number"]}
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 65535},
            {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 15}
          ]
        },
        "to": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ipBlock": {"type": "object"},
              "namespaceSelector": {"type": "object"},
              "podSelector": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
