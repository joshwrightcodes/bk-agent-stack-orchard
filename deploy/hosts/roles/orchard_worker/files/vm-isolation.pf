# Keeps the job VMs of this host away from the host (target design, section 9.1).
#
# Softnet blocks a VM from the private ranges and from the other VMs, but it lets the VM reach the
# gateway of the VM network on every port, and the gateway is this host. A Softnet block of the
# gateway also blocks DNS, because the host is the DNS server of the VMs. These rules let a VM reach
# the host only for DHCP and DNS.
#
# The VM network is the default of vmnet. The playbook checks that the host does not change it.
vm_net = "192.168.64.0/24"
host_on_vm_net = "192.168.64.1"

# A connection that the host opens to a VM, for example the SSH startup transport, keeps its
# replies.
pass out quick from any to $vm_net keep state

# The host itself, on its address in the VM network. Softnet lets a VM send only from the address
# of its own DHCP lease, so no VM can use this rule. A host that is itself a VM on a network of
# this range, as in the test of the playbook, needs it to stay reachable.
pass in quick from $host_on_vm_net to self

# DHCP, so that a VM keeps its lease.
pass in quick proto udp from $vm_net port 68 to { $host_on_vm_net, 255.255.255.255 } port 67

# DNS, to the resolver that DHCP gives the VM.
pass in quick proto { udp, tcp } from $vm_net to $host_on_vm_net port 53

# Nothing else from a VM reaches an address of the host.
block in quick from $vm_net to { $host_on_vm_net, self }
