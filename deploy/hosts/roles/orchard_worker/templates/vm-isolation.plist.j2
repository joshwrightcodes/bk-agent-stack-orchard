<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ ansible_managed }} -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>{{ orchard_worker_pf_label }}</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <string>/sbin/pfctl -E; /sbin/pfctl -a {{ orchard_worker_pf_anchor }} -f {{ orchard_worker_pf_rules }}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/bkaso-vm-isolation.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/bkaso-vm-isolation.log</string>
  </dict>
</plist>
