#!/bin/bash
# The environment hook of the image. The owner-managed artifact storage is optional (PR-032, owner
# decision of 2026-11-02, target design, section 7.6). When the build gives the image a storage,
# the artifacts of a job go to it, and a pipeline step may name another place in the same storage.
# When it does not, the hook leaves the destination alone, and buildkite-agent uploads to the
# storage of Buildkite.
#
# buildkite-agent sources this file and then reads the environment, so the file sets its values
# and ends. An exit here would end the wrapper of the agent before it reads them.

# The guest agent starts buildkite-agent with a PATH that lacks Homebrew, so a job of the pilot
# finds its formulae through this hook. fastlane and CocoaPods need a UTF-8 locale.
if [[ -x /opt/homebrew/bin/brew ]]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
	export LANG="${LANG:-en_US.UTF-8}"
fi

bkaso_owner="__ARTIFACT_DESTINATION__"

if [[ -z "$bkaso_owner" ]]; then
	# Informational only: an empty destination is the storage of Buildkite, which is allowed.
	:
elif [[ "${BUILDKITE_ARTIFACT_UPLOAD_DESTINATION:-}" != "$bkaso_owner" &&
	"${BUILDKITE_ARTIFACT_UPLOAD_DESTINATION:-}" != "$bkaso_owner"/* ]]; then
	export BUILDKITE_ARTIFACT_UPLOAD_DESTINATION="${bkaso_owner}/${BUILDKITE_PIPELINE_SLUG}/${BUILDKITE_BUILD_ID}/${BUILDKITE_JOB_ID}"
fi

unset bkaso_owner
